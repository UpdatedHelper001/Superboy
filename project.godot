; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="PSP Open World"
config/icon="res://icons/icon_192.png"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

StoryManager="*res://scripts/StoryManager.gd"
SaveManager="*res://scripts/SaveManager.gd"

[input]

interact={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":69,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[display/window]
size/viewport_width=960
size/viewport_height=540
size/window_width_override=960
size/window_height_override=540
stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[input_devices]
pointing/emulate_mouse_from_touch=false

[importer_defaults]

texture={
"compress/mode": 2,
"mipmaps/generate": true
}
